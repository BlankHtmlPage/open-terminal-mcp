# Open Terminal connection
OPEN_TERMINAL_URL=http://localhost:8000
OPEN_TERMINAL_API_KEY=your-open-terminal-api-key

# Inbound auth token clients must present (min 16 chars)
MCP_AUTH_TOKEN=generate-a-long-random-secret

# Server
PORT=3000

# Optional tuning
OPEN_TERMINAL_TIMEOUT_MS=30000
# MCP_CORS_ORIGIN=*

# Optional Open Terminal multi-user / session pinning
# OPEN_TERMINAL_USER_ID=
# OPEN_TERMINAL_SESSION_ID=
